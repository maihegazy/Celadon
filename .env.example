# Copy to .env and fill in. Everything here is EXPO_PUBLIC_*, meaning it is
# bundled into the app — only ever put publishable keys in this file.

# Supabase — Project Settings → API
# Without these the app runs on device-only stand-ins: accounts and profiles
# stay on the phone, and nothing is sent anywhere.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Meal analysis backend. Omit to use the on-device stub.
# EXPO_PUBLIC_MEAL_ANALYSIS_URL=https://api.example.com/v1/meals
# EXPO_PUBLIC_MEAL_ANALYSIS_TOKEN=
